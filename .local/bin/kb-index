#!/usr/bin/env python3
# Build <KB>/Index.md: every note with its summary and sections, plus where each
# IP and Proxmox guest (CT/VM id) is documented. Run after adding notes or sections.
import re
import sys
from collections import defaultdict
from datetime import date
from pathlib import Path

# Same vault, synced to a different place per machine: Hana ~/MEGA/Notes, work MacBook ~/MEGA/Linux/Notes
KB = next((p for p in (Path.home() / "MEGA/Notes/Claude", Path.home() / "MEGA/Linux/Notes/Claude") if p.is_dir()), None)
if KB is None:
    sys.exit("kb-index: no KB folder found")
OUT = KB / "Index.md"
IP = re.compile(r"\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b")
GUEST = re.compile(r"\b(?:CT|VM) (\d{3})\b|^\| (\d{3}) \| (?:CT|VM) \|")  # prose, or a Proxmox table row


def front_matter(text):
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return {}, text
    meta = dict(re.findall(r"^(\w+): *\"?(.*?)\"?$", m.group(1), re.M))
    return meta, text[m.end():]


def gist(line, width=110):
    # first content line of a section, without markdown noise
    table = line.lstrip().startswith("|")
    s = re.sub(r"\[\[([^]|#]*#)?([^]|]+)(\|[^]]+)?\]\]", r"\2", line)
    s = re.sub(r"[*`>]|^\s*[-+]\s+|^\s*\d+\.\s+|^\|\s*", "", s).replace(" | ", ", ").strip(" |")
    s = ("table: " if table else "") + re.sub(r"\s+", " ", re.sub(r"\s*,\s*", ", ", s))
    return s if len(s) <= width else s[: width - 1].rstrip() + "…"


def main():
    notes = sorted(p for p in KB.rglob("*.md") if p != OUT and "node_modules" not in p.parts)
    ips, guests = defaultdict(set), defaultdict(set)
    lines = [
        "---",
        "tags: [index]",
        'summary: "Generated by ~/.local/bin/kb-index: notes, sections with line ranges and gist, IPs and Proxmox guests"',
        f"updated: {date.today()}",
        "---",
        "# Index",
        "",
        "Generated, do not edit by hand: L<start>-<end> = file lines, read just that range. Rerun `kb-index` after any KB edit (line numbers shift).",
    ]
    folder = None
    for p in notes:
        rel = p.relative_to(KB)
        if rel.parts[0] != folder:
            folder = rel.parts[0] if len(rel.parts) > 1 else "."
            lines += ["", f"## {folder}"]
        text = p.read_text(encoding="utf-8")
        meta, body = front_matter(text)
        all_lines = text.splitlines()
        first = len(all_lines) - len(body.splitlines())  # lines taken by the front matter
        summary = meta.get("summary", "")
        updated = f" ({meta['updated']})" if "updated" in meta else ""
        lines.append(f"- [[{p.stem}]] `{rel}` {len(all_lines)} lines{updated}" + (f": {summary}" if summary else ""))
        # (level, file line no, name, gist); a section runs until the next heading of the same or higher level
        heads, section, in_code = [], p.stem, False
        for no, line in enumerate(all_lines[first:], first + 1):
            if line.startswith("```"):
                in_code = not in_code
            elif not in_code and (m := re.match(r"(##+) (.+)", line)) and len(m.group(1)) <= 3:
                section = f"{p.stem}#{m.group(2).strip()}"
                heads.append([len(m.group(1)), no, section, ""])
            elif heads and not heads[-1][3] and not in_code and line.strip() and not re.match(r"\|?[\s|:-]+\|?$", line):
                heads[-1][3] = gist(line)
            if p.stem == "TODO":  # change log: history, not where the current state lives
                continue
            for ip in IP.findall(line):
                ips[ip].add(section)
            for gid in ("".join(g) for g in GUEST.findall(line)):
                guests[gid].add(section)
        for i, (level, start, name, text_gist) in enumerate(heads):
            end = next((h[1] - 1 for h in heads[i + 1:] if h[0] <= level), len(all_lines))
            lines.append(f"{'  ' * (level - 1)}- [[{name}]] L{start}-{end}" + (f": {text_gist}" if text_gist else ""))

    def refs(sections):
        return " · ".join(f"[[{s}]]" for s in sorted(sections)[:8]) + (" …" if len(sections) > 8 else "")

    lines += ["", "## Proxmox guests (CT/VM id → where documented)", ""]
    lines += [f"- **{gid}**: {refs(s)}" for gid, s in sorted(guests.items())]
    lines += ["", "## IPs (10.x → where documented)", ""]
    key = lambda ip: tuple(int(x) for x in ip.split("."))
    lines += [f"- `{ip}`: {refs(s)}" for ip, s in sorted(ips.items(), key=lambda kv: key(kv[0]))]
    OUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"{OUT}: {len(notes)} notes, {len(guests)} guests, {len(ips)} IPs")


if __name__ == "__main__":
    sys.exit(main())
